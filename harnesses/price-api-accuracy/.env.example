# Every key is optional: a provider whose key is unset is logged as disabled
# and publishes nothing, rather than publishing failures.
BITCULATOR_API_KEY=
MOBULA_API_KEY=
COINSTATS_API_KEY=
CODEX_API_KEY=
SERIALIZED_API_KEY=
# CoinGecko: a demo key, or the keyless public API through a proxy when the
# host's address is rate limited. One of the two must be set.
COINGECKO_DEMO_KEY=
COINGECKO_PROXY_URL=
# LISTEN_ADDR=:2112
# REFERENCE_INTERVAL=5s
