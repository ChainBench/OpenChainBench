# L2 sequencer WebSocket endpoints. Defaults are public no-key
# endpoints verified live at inception (see README probe results).
# Override any of these without a rebuild if an upstream goes flaky.

# RPC_WS_ARBITRUM=wss://arbitrum-one-rpc.publicnode.com
# RPC_WS_OPTIMISM=wss://optimism-rpc.publicnode.com
# RPC_WS_BASE=wss://base-rpc.publicnode.com
# RPC_WS_ZKSYNC=wss://mainnet.era.zksync.io/ws
# RPC_WS_LINEA=wss://linea-rpc.publicnode.com
# RPC_WS_SCROLL=wss://scroll-rpc.publicnode.com
# RPC_WS_BLAST=wss://blast-rpc.publicnode.com
# RPC_WS_MANTLE=wss://mantle-rpc.publicnode.com
# RPC_WS_TAIKO=wss://taiko-rpc.publicnode.com

# Railway injects $PORT; defaults to :2112 locally.
# PORT=2112
