# Region this replica self-labels into every emitted metric.
# One Railway service per region, each with its own MONITOR_REGION value.
# us-east | eu-west | sgp | unknown (default)
MONITOR_REGION=local

# Mobula API key (required to probe Mobula).
# Sent as raw `Authorization: <key>` header — NO Bearer prefix.
MOBULA_API_KEY=

# Jupiter API key (optional). Public lite endpoint works without it.
JUPITER_API_KEY=

# DFlow API key (reserved). The DFlow adapter is currently a stub
# pending partnership API access.
DFLOW_API_KEY=

# Optional shared token gating GET /logs?tail=N.
# When unset, /logs returns 404.
LOGS_TOKEN=
