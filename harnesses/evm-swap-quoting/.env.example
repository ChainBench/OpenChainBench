# Mobula required (the swap quoting endpoint is auth-gated).
MOBULA_API_KEY=

# Region label that lands on every metric. Set per Railway replica.
# Allowed: us-east, eu-west, sgp
MONITOR_REGION=eu-west

# Optional: free-tier keys for the providers that need them. Without these
# the harness simply skips the corresponding provider (or runs anonymous
# with degraded throughput, in Enso's case). Sign-up:
#   https://portal.1inch.dev          (100k req/month, 1 RPS)
#   https://app.odos.xyz/api          (avoids the anonymous 3-call rate limit)
#   https://shortcuts.enso.finance    (widens the anonymous 1rps bucket;
#                                      without a key Enso is ~90 % throttled
#                                      because the bucket is shared across
#                                      all anonymous callers worldwide)
ONEINCH_API_KEY=
ODOS_API_KEY=
ENSO_API_KEY=

# Optional token-gate on /logs?tail=N. Same shared token as the other OCB
# harnesses if you want one curl to fetch logs across services.
LOGS_TOKEN=
