# Mobula API key: the Mobula gauges, and bench 280 market caps on the chains
# with a verified Mobula asset id (without it they fall back to keyless CoinGecko)
MOBULA_API_KEY=
# Refresh intervals in minutes (optional)
MOBULA_REFRESH_MINUTES=
DEFILLAMA_REFRESH_MINUTES=
# CoinGecko demo key (optional): lifts the keyless rate limit on the fallback call
COINGECKO_API_KEY=
