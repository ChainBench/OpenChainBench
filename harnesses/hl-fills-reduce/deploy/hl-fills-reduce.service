[Unit]
Description=Reduce the Hyperliquid node fill stream to per-builder daily totals
After=hyperliquid.service
Wants=hyperliquid.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStart=/usr/local/bin/hl-fills-reduce -addr 127.0.0.1:2115
Restart=always
RestartSec=30
# The node is the priority on this box. Reducing a day reads four gigabytes
# and must never be the reason a block is applied late.
Nice=15
IOSchedulingClass=3
MemoryMax=2G

[Install]
WantedBy=multi-user.target
