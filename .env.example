# Optional. If set, overrides any `prometheus.url` in benchmark YAML specs.
# Leave unset locally — the spec files already embed their URL.
# PROMETHEUS_URL=https://prometheus-production-0859.up.railway.app

# Where /api/report delivers a reader's bug report. Telegram is tried first
# and Slack is the fallback; with neither set the route answers 503 and the
# form says reporting is not configured.
#
# TELEGRAM_CHAT_ID is the destination, not the bot: send the bot any message,
# then read it from
#   https://api.telegram.org/bot<token>/getUpdates  -> result[].message.chat.id
# A personal chat id is a positive integer; a group's is negative.
# TELEGRAM_BOT_TOKEN=123456:AA...
# TELEGRAM_CHAT_ID=123456789
#
# Legacy. Still honoured when Telegram is unset.
# SLACK_REPORT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional. Live-page WebSocket relay. Public (NEXT_PUBLIC_) so it's baked
# into the browser bundle. Defaults to the production relay if unset.
# NEXT_PUBLIC_RELAY_WS_URL=wss://ocb-stream-relay-production.up.railway.app/ws

# Optional. Minimum seconds between two full ISR tag purges triggered by
# the materialize worker's /api/internal/revalidate-aggregate hook. The
# worker calls the hook after every 60 s publish; without this throttle
# every ISR page was invalidated each minute. Default 600. "0" disables.
# REVALIDATE_MIN_INTERVAL_SEC=600

# API keys: the CRM calls /api/internal/api-access* with this bearer to list,
# approve, decline and revoke key requests. 32+ characters, the same value on
# Vercel and on Railway (the CRM). To rotate it: 1) on Vercel set
# API_ACCESS_ADMIN_TOKEN_NEXT to the new value and redeploy; 2) on Railway
# set API_ACCESS_ADMIN_TOKEN to the new value and redeploy the CRM; 3) on
# Vercel move the new value to API_ACCESS_ADMIN_TOKEN, clear
# API_ACCESS_ADMIN_TOKEN_NEXT and redeploy.
# Without it (or shorter than 32) the internal routes answer 503.
# On Vercel, set both only for Production: Preview builds any pushed branch.
# API_ACCESS_ADMIN_TOKEN=
