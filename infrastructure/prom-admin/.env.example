# Layer 2 — HTTP Basic Auth for the UI itself. Even if Cloudflare Access
# (Layer 1) is bypassed by misconfig, the app refuses without these.
ADMIN_USER=
ADMIN_PASS=

# Layer 3 — Bearer the Caddy gateway expects to forward to Prom admin API.
# NEVER touches the browser. Set this to the same value as on the
# prom-gateway Railway service.
PROM_ADMIN_TOKEN=

# Public URL of the Caddy gateway (NOT the Prometheus internal DNS).
# e.g. https://prom-gateway-production-xxxx.up.railway.app
PROM_GATEWAY_URL=

# Optional kill-switch for the auto-bulk smart-clean endpoint. Default off.
SMART_CLEAN_ENABLED=false
